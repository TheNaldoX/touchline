<Project Sdk="Microsoft.NET.Sdk">
  <!-- Tests EditMode du Core exécutés hors Unity (NUnit et UnityEngine simulés, voir README). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net8.0</TargetFramework><LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable><ImplicitUsings>disable</ImplicitUsings><Optimize>true</Optimize>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems><ServerGarbageCollection>true</ServerGarbageCollection>
    <NoWarn>CS0168;CS0219;CS0414;CS0649;CS0169;CS8632;CS0162;CS0618;CS1717</NoWarn>
    <CoreDir Condition="'$(CoreDir)'==''">../../unity/Touchline/Assets/Touchline/Core</CoreDir>
    <TestsDir>../../unity/Touchline/Assets/Touchline/Tests/EditMode</TestsDir>
  </PropertyGroup>
  <Import Project="excluded-tests.props" />
  <ItemGroup>
    <Compile Include="$(CoreDir)/**/*.cs" />
    <Compile Include="*.cs" />
    <Compile Include="$(TestsDir)/*.cs" Exclude="@(ExcludedTest->'$(TestsDir)/%(Identity)')" />
  </ItemGroup>
</Project>
